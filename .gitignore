node_modules/
dist/
*.log
.DS_Store
Thumbs.db
keygen.js
keygen.html
*.map

# Editor configs
.vscode/
.idea/

# Electron sensitive runtime files
*.enc
*.dat

# Archive/scratch files (do not recommit)
app_old.js
archive_recovery.js
.scratch-*
.lucide-tmp/

# Playwright (Phase 0 e2e safety net)
test-results/
playwright-report/
blob-report/
.last-run.json

# Dev-mode app data — never the real client database
.devdata/

# Control-plane server — its own dependency tree, not the app's
server/node_modules/
server/.env

# Single-file web bundle (scripts/build-web-bundle.js) — a browser preview of
# the renderer, rebuilt on demand. The subset icon font is a build input for it
# only; the shipped app keeps the full material-symbols-rounded.woff2.
dist-web/
renderer/vendor/fonts/*.subset.woff2
