{
  "name": "hostyllo-control-plane",
  "version": "0.1.0",
  "private": true,
  "description": "Licensing control plane and admin portal for the offline Hostyllo desktop app. Separate service, separate database, no connection to the Hostyllo SaaS.",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env src/migrate.js",
    "migrate:status": "node --env-file-if-exists=.env src/migrate.js --status",
    "test": "node test/run.js && node test/http.js",
    "create-admin": "node --env-file-if-exists=.env src/scripts/create-admin.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.1.1",
    "bcryptjs": "^3.0.2",
    "fastify": "^5.2.1",
    "pg": "^8.13.1"
  }
}
