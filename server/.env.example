# Control plane — environment
#
# Copy to server/.env for local use. That file is gitignored; keep it that way.
# On Railway these go in the service's Variables tab instead.

# ── Required — the service refuses to start without these ───────────────────

# Railway → your Postgres service → Variables → DATABASE_PUBLIC_URL when running
# from a laptop, DATABASE_URL when running inside Railway. The private hostname
# (postgres.railway.internal) does not resolve from outside Railway's network,
# so a migration run from your machine with that one hangs and then times out.
DATABASE_URL=postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway

# Signs the admin session cookie. At least 32 characters.
#   openssl rand -hex 32
SESSION_SECRET=

# ── Optional — each capability is OFF until set, and says so ────────────────

# The Ed25519 PRIVATE key that signs entitlements. Without it /v1/entitlement
# returns 503 and no app can receive licence updates. It is the whole JWK on one
# line, from scripts/gen-entitlement-keypair.js:
#   node -e "process.stdout.write(require('fs').readFileSync(process.argv[1],'utf8').replace(/\s+/g,''))" \
#     "C:/Users/PCS/HOSTIX-backups/entitlement-keys/entitlement-ent-20260819.private.jwk.json"
# NEVER commit this. NEVER let it reach the desktop app.
ENTITLEMENT_SIGNING_JWK=

# The secret the app's licence-key checksum uses — the hex blob at the top of
# keygen.js, decoded. Without it, device registration and key issuing return 503.
# NOT a trust boundary: it ships inside app.asar, so it filters typos and nothing
# more. Read it with:
#   node -e "console.log(Buffer.from(require('fs').readFileSync('keygen.js','utf8').match(/'([0-9a-f]{40,})'/)[1],'hex').toString())"
LEGACY_KEY_SECRET=

# ── Policy — safe to leave unset ────────────────────────────────────────────

# Days past expiry the app still runs fully, with a renewal warning.
GRACE_DAYS=14

# Whether the app goes read-only past grace. Never destructive either way.
READONLY_ON_EXPIRY=true

# How long an app may keep running on a cached entitlement while offline.
ENTITLEMENT_CACHE_DAYS=14

# What an unverified licence is granted: ACTIVE (default) or GRACE.
# Left ACTIVE so the ~50 hostels whose keys this database has no record of do
# not all see a renewal warning for a valid licence. Tighten to GRACE once the
# unverified queue is actually being worked.
UNVERIFIED_STATUS=ACTIVE

# ── Runtime ─────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
LOG_LEVEL=info
