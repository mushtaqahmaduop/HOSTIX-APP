{
  "name": "damam-hostel",
  "version": "4.0.0",
  "description": "DAMAM Boys Hostel Management System",
  "author": {
    "name": "MUSHTAQ AHMAD",
    "email": "mushtaqahmadicp@gmail.com"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron . --dev",
    "build": "electron-builder --win --x64 --ia32",
    "build:portable": "electron-builder --win portable --x64 --ia32",
    "build:installer": "electron-builder --win nsis --x64 --ia32",
    "build:all": "electron-builder --win --x64 --ia32",
    "test:license": "node test-license.js",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "build": {
    "appId": "com.damam.hostel",
    "productName": "DAMAM Boys Hostel",
    "copyright": "Copyright \u00a9 2025 MUSHTAQ AHMAD",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/bindings/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "renderer/**/*",
      "main.js",
      "preload.js",
      "assets/**/*",
      "package.json",
      "!keygen.js",
      "!keygen.html",
      "!test-license.js",
      "!**/*.md",
      "!**/.git/**",
      "!**/node_modules/.bin/**",
      "!dist/**",
      "!**/Thumbs.db",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "assets/logo.ico",
      "requestedExecutionLevel": "asInvoker",
      "fileAssociations": [],
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DAMAM Hostel",
      "installerIcon": "assets/logo.ico",
      "uninstallerIcon": "assets/logo.ico",
      "installerHeader": "assets/logo.ico",
      "license": null,
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false,
      "include": null
    },
    "portable": {
      "artifactName": "DAMAM-Hostel-Portable-${version}-${arch}.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "mushtaqahmaduop",
      "repo": "HOSTIX-APP",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "electron": "^22.3.27",
    "electron-builder": "^26.8.1",
    "electron-rebuild": "^3.2.9"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "better-sqlite3": "^9.4.3"
  }
}
