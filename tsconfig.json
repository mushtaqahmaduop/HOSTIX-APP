{
  "// NOTE": "Dev-time TYPE-CHECKING only — no build step, no emit. The app still",
  "// NOTE2": "ships the exact same plain .js via <script> tags. Run: npm run typecheck.",
  "// NOTE3": "Scope grows one file at a time (Phase 2 §6.1) as files are annotated.",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2020",
    "module": "none",
    "lib": ["ES2020", "DOM"],
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true
  },
  "include": [
    "renderer/globals.d.ts",
    "renderer/src/utils.js",
    "renderer/src/toolbar.js",
    "renderer/src/finance.js",
    "renderer/src/ledger.js",
    "renderer/src/handovers.js",
    "renderer/src/ownership.js",
    "renderer/src/messExempt.js",
    "renderer/src/concessions.js",
    "renderer/src/storage.js",
    "renderer/src/receipt.js",
    "renderer/src/export/xlsx-writer.js",
    "renderer/src/export/engine.js",
    "renderer/src/license.js"
  ]
}
